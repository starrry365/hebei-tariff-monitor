# ────────────────────────────────────────────────────────────
# hebei-tariff-monitor 推送通道配置模板
# ────────────────────────────────────────────────────────────
# 用法：
#   1. cp .env.example .env
#   2. 按需填入下面任一组凭据（配几个推几个；不配置的通道自动跳过）
#   3. python cloud/tariff/notify.py --test   验证通道
#
# 🔴 .env 已被 .gitignore 忽略，不会被提交到 GitHub
#    GitHub Actions 用 Secrets（同名），不会被 .env 覆盖
# ────────────────────────────────────────────────────────────

# ════════════ 总开关 ════════════
# 全关：NOTIFY=0
# 只关本脚本这一路（仍允许外部编排推）：SELF_NOTIFY=0
# 无变化也每天报平安（默认 0，只推真变化）：NOTIFY_ALWAYS=1
NOTIFY=1
SELF_NOTIFY=1
NOTIFY_ALWAYS=0

# ════════════ PushPlus（微信推送）════════════
# 申请：https://www.pushplus.plus/ 扫码登录 → 「一对一推送」页复制 token
PUSHPLUS_TOKEN=
# 可选：群组编码（一对多推送给家人/小号）
PUSHPLUS_TOPIC=

# ════════════ SMTP 邮件 ════════════
# 常见服务商：
#   QQ 邮箱     smtp.qq.com        465   SSL=1  （用「授权码」不是登录密码）
#   网易 163    smtp.163.com       465   SSL=1  （用「授权码」不是登录密码）
#   Gmail       smtp.gmail.com     587   SSL=0  （用「应用专用密码」）
#   腾讯企业邮  smtp.exmail.qq.com 465   SSL=1
#   Outlook     smtp-mail.outlook.com 587  SSL=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 465 用 SSL=1 / 587 用 STARTTLS（SSL=0）
SMTP_SSL=1

# 收件人（多个用逗号分隔）
MAIL_TO=
# 发件人（通常和 SMTP_USER 一样；不填则取 SMTP_USER）
MAIL_FROM=
# 发件人显示名（可选）
MAIL_FROM_NAME=资费监控
