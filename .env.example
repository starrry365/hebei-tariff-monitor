# ────────────────────────────────────────────────────────────
# hebei-tariff-monitor 推送通道配置模板
# ────────────────────────────────────────────────────────────
# 用法：
#   1. cp .env.example .env
#   2. 按需填入下面任一组凭据（配几个推几个；不配置的通道自动跳过）
#   3. python cloud/tariff/notify.py --test   验证通道
#
# 🔴 .env 已被 .gitignore 忽略，不会被提交到 GitHub
#    GitHub Actions 用 Secrets（同名），不会被 .env 覆盖
# ────────────────────────────────────────────────────────────

# ════════════ 总开关 ════════════
# 全关：NOTIFY=0
# 只关本脚本这一路（仍允许外部编排推）：SELF_NOTIFY=0
# 无变化也每天报平安（默认 0，只推真变化）：NOTIFY_ALWAYS=1
NOTIFY=1
SELF_NOTIFY=1
NOTIFY_ALWAYS=0

# ════════════ 钉钉群机器人 ════════════
# 获取：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义（Webhook 地址）
# 安全设置三选一，推荐「加签」（最稳，webhook 万一泄露别人也发不了）：
#   · 加签          → 把「加签」那串 SEC 填进 DINGTALK_SECRET
#   · 自定义关键词   → 不填 SECRET，但消息里必须含该词（本项目的推送标题含「资费巡检」）
#   · IP 白名单      → 别选：GitHub Actions 的出口 IP 不固定
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ════════════ 飞书群机器人 ════════════
# 获取：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人（Webhook 地址）
# 同样可选「签名校验」→ 填 FEISHU_SECRET
# 🔴 钉钉与飞书的加签算法**不一样**，别互相套用：
#    钉钉 HMAC-SHA256(key=secret, msg=ts+"\n"+secret)
#    飞书 HMAC-SHA256(key="",     msg=ts+"\n"+secret)
#    抄错会一直 sign not match / 310000（两个算法都写在 notify.py 自测里）
FEISHU_WEBHOOK=
FEISHU_SECRET=

# ════════════ 企业微信群机器人 ════════════
# 获取：企业微信群 → 右上角 → 群机器人 → 添加 → 复制 Webhook 地址
# 企微机器人**没有**加签，只有 webhook（泄露了就把机器人移除重加）
WECOM_WEBHOOK=

# ════════════ PushPlus（微信推送）════════════
# 申请：https://www.pushplus.plus/ 扫码登录 → 「一对一推送」页复制 token
PUSHPLUS_TOKEN=
# 可选：群组编码（一对多推送给家人/小号）
PUSHPLUS_TOPIC=

# ════════════ SMTP 邮件 ════════════
# 常见服务商：
#   QQ 邮箱     smtp.qq.com        465   SSL=1  （用「授权码」不是登录密码）
#   网易 163    smtp.163.com       465   SSL=1  （用「授权码」不是登录密码）
#   Gmail       smtp.gmail.com     587   SSL=0  （用「应用专用密码」）
#   腾讯企业邮  smtp.exmail.qq.com 465   SSL=1
#   Outlook     smtp-mail.outlook.com 587  SSL=0
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 465 用 SSL=1 / 587 用 STARTTLS（SSL=0）
SMTP_SSL=1

# 收件人（多个用逗号分隔）
MAIL_TO=
# 发件人（通常和 SMTP_USER 一样；不填则取 SMTP_USER）
MAIL_FROM=
# 发件人显示名（可选）
MAIL_FROM_NAME=资费监控

# ════════════ 新鲜度巡检（check_fresh.py / fresh-check.yml）════════════
# 数据「超过这么久没更新」判为过期并告警。
# 巡检每日一轮（06:00），30 小时 = 留 6 小时给 GitHub 排队容错；
# 连着两轮没跑必然报警（这是唯一能抓到「job 根本没启动」的手段）。
FRESH_MAX_HOURS=30

# ════════════ 采样噪声护栏（noise_guard.py）════════════
# 整板块的 (新增+下线) 同时满足「比例 > NOISE_RATIO」且「绝对数 ≥ NOISE_MIN_ABS」
# → 判为上游按随机子集轮换造成的抖动，本轮不写进历史。
# 两条缺一不可：只看比例会误伤小网（3 条动 2 条 = 67%），
#               只看绝对数会误伤大网（8000 条动 60 条 = 0.75% 很正常）。
NOISE_RATIO=0.3
NOISE_MIN_ABS=50

# history.json 瘦身（防逐日膨胀）：每条记录最多留几个样本 / 单条长文本上限
HIST_SAMPLE_LIMIT=12
DETAIL_TEXT_LIMIT=200
